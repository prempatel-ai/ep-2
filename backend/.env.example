# Copy to .env and edit. Every value has a default; set only what you change.

# --- Language model (your fine-tuned model, served by llama.cpp's llama-server) ---
SAHAYAK_LLM__BACKEND=openai_compatible     # use "echo" to build the UI without a model
SAHAYAK_LLM__BASE_URL=http://127.0.0.1:8080/v1

# --- Retrieval over the verified FAQs ---
SAHAYAK_RETRIEVAL__BACKEND=chroma          # "disabled" runs without an index
SAHAYAK_RETRIEVAL__FAQ_PATH=data/faqs.jsonl
SAHAYAK_RETRIEVAL__DIRECT_THRESHOLD=0.90
SAHAYAK_RETRIEVAL__CONTEXT_THRESHOLD=0.55

# --- Speech ---
SAHAYAK_STT__BACKEND=faster_whisper        # faster_whisper | indic_conformer | disabled
SAHAYAK_STT__WHISPER_MODEL=small
SAHAYAK_TTS__BACKEND=mms                   # mms | indic_parler | disabled

# --- Server ---
SAHAYAK_DEFAULT_LANGUAGE=gu
SAHAYAK_LOG_LEVEL=INFO
SAHAYAK_CORS_ORIGINS=["http://localhost:5173"]
